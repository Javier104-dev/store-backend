{
  "name": "template-back",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "prestart:prod": "npm run migration:run && npm run sentry:sourcemaps",
    "start:prod": "node dist/src/main",
    "start:cd": "npm run migration:run && npm run start:prod",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix --max-warnings=0",
    "test": "cross-env NODE_ENV=automated_tests jest --maxWorkers=1",
    "test:watch": "cross-env NODE_ENV=automated_tests jest --watch",
    "test:cov": "cross-env NODE_ENV=automated_tests jest --coverage --no-cache --runInBand",
    "test:debug": "cross-env NODE_ENV=automated_tests node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "typeorm": "ts-node -r tsconfig-paths/register ./typeorm.custom-cli.ts",
    "schema:drop": "cross-env NODE_ENV=development npm run typeorm -- schema:drop -d ./src/config/orm.config.ts",
    "schema:sync": "cross-env NODE_ENV=development npm run typeorm -- schema:sync -d ./src/config/orm.config.ts",
    "migration:create": "cross-var npm run typeorm -- migration:create ./data/migrations/$npm_config_name",
    "migration:generate": "cross-var npm run typeorm -- migration:generate -d ./src/config/orm.config.ts ./data/migrations/$npm_config_name",
    "migration:run": "npm run typeorm -- migration:run -d ./src/config/orm.config.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d ./src/config/orm.config.ts",
    "fixtures": "cross-env NODE_ENV=development fixtures load ./data/fixture --sync --debug --dataSource=./src/config/orm.config.ts --require=ts-node/register --require=tsconfig-paths/register",
    "generate:crud": "yo generators/app/crud --force",
    "cognito:prepare": "cross-env ./data/scripts/create_user_pool.sh",
    "sqs:prepare": "cross-env ./data/scripts/create_sqs_queue.sh",
    "ses:prepare": "cross-env ./data/scripts/create_ses_identity_email.sh",
    "s3:prepare": "cross-env ./data/scripts/create_s3_bucket.sh",
    "sns:prepare": "cross-env ./data/scripts/create_sns_topic.sh",
    "aws:prepare": "npm run cognito:prepare && npm run sqs:prepare && npm run ses:prepare && npm run s3:prepare && npm run sns:prepare",
    "dev:prepare": "cross-env ./data/scripts/create_default_env.sh",
    "sentry:sourcemaps": "cross-env sentry-cli sourcemaps inject ./dist && cross-env sentry-cli sourcemaps upload ./dist",
    "prepare": "husky install"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.906.0",
    "@aws-sdk/client-s3": "^3.913.0",
    "@aws-sdk/client-ses": "^3.906.0",
    "@aws-sdk/client-sns": "^3.906.0",
    "@aws-sdk/client-sqs": "^3.906.0",
    "@casl/ability": "^6.7.3",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/typeorm": "^11.0.0",
    "@ssut/nestjs-sqs": "^3.0.1",
    "aws-sdk": "^2.1692.0",
    "better-sqlite3": "^12.5.0",
    "change-case-all": "^2.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "jsonapi-serializer": "^3.6.9",
    "jwks-rsa": "^3.2.0",
    "openai": "^6.2.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "session-file-store": "^1.5.0",
    "typeorm": "^0.3.27",
    "typeorm-naming-strategies": "^4.1.0",
    "typeorm-transactional": "^0.5.0",
    "uuid4": "^2.0.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonapi-serializer": "^3.6.8",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typeorm-fixtures-cli": "^4.1.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.55.0"
  }
}
